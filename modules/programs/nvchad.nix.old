{ config, pkgs, ... }:

let
  nvchad = pkgs.fetchFromGitHub {
    owner = "NvChad";
    repo = "NvChad";
    rev = "v2.5"; # pin this
    sha256 = "sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=";
  };
in
{
  home.file.".config/nvim".source = nvchad;

  # Your custom config layer
  home.file.".config/nvim/lua/custom".source = ./nvim;
}